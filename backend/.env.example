# AnnaSetu Backend Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit real secret keys to source control.

# ─── Runtime ────────────────────────────────────────────────
APP_ENV=development
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# ─── Demo Mode (Phase 19 — explicit, never inferred) ───────
# DEMO_MODE must be true to enable seed, reset, and demo data.
# It is automatically disabled in production regardless of value.
DEMO_MODE=false
DEMO_NAMESPACE_TAG=DEMO_SCENARIO_1
# Optional. If set, the reset endpoint also requires this token.
DEMO_RESET_TOKEN=

# ─── Supabase (server-side only) ────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Payments ───────────────────────────────────────────────
# Use "mock" for hackathons and local demos, "razorpay" for live.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEFAULT_PLATFORM_FEE_PERCENT=12.0

# ─── Routing ────────────────────────────────────────────────
# Use "haversine" to work without a live map provider (default, fallback-safe).
ROUTING_PROVIDER=haversine

# ─── AI ─────────────────────────────────────────────────────
# Set AI_ENABLED=false for fully deterministic, offline-safe demos.
AI_PROVIDER=groq
AI_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
AI_REQUEST_TIMEOUT_SECONDS=10.0
AI_MAX_RETRIES=1
